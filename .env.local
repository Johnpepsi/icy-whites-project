# Copy this file to .env.local

# Your Calendly scheduling link, used to open the booking popup.
# Find it in Calendly under an Event Type -> Share -> copy the link.
# Example: https://calendly.com/your-name/whitening-session
#
# Payment collection (the $50 CAD charge) is configured on Calendly's side,
# not here — connect Stripe under Calendly's Integrations settings, then
# turn on "Collect payment details" for this event type.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/apolonixtech/30min
